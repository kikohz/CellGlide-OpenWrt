{
	"luci-app-cellglide": {
		"description": "Grant access to CellGlide",
		"read": {
			"ubus": {
				"luci.cellglide": [ "status", "paired", "map" ],
				"luci-rpc": [ "getDHCPLeases" ]
			},
			"uci": [ "cellglide" ]
		},
		"write": {
			"ubus": {
				"luci.cellglide": [ "pair", "start", "map_geoip", "diag", "diag_send", "diag_result" ]
			},
			"uci": [ "cellglide" ]
		}
	}
}
