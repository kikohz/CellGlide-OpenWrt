// rpcd plugin behind the CellGlide pages: status for the overview, pairing, starting the
// service and the diagnostics report. Everything else (devices, settings) goes through
// LuCI's own UCI calls.
'use strict';

import { readfile, writefile, popen, mkdir, unlink } from 'fs';
import { cursor } from 'uci';

const ubus = require('ubus').connect();

// Where a diagnostics report waits while it is sent; only root can read it.
const DIAG = '/tmp/cellglide-diag';
const DIAG_TOOL = '/usr/libexec/cellglide/diag';

// The daemon's status file: key='value' lines with quotes and line breaks already removed.
function read_status() {
	const status = {};
	for (let line in split(readfile('/var/run/cellglide/status') ?? '', '\n')) {
		const m = match(line, /^([a-z]+)='(.*)'$/);
		if (m)
			status[m[1]] = m[2];
	}
	return status;
}

function service_running() {
	const list = ubus.call('service', 'list', { name: 'cellglide' });
	return !!list?.cellglide?.instances?.daemon?.running;
}

function run(command) {
	const fd = popen(command + ' 2>&1');
	if (!fd)
		return { code: -1, output: '' };
	const output = fd.read('all');
	return { code: fd.close(), output: trim(output ?? '') };
}

// The report for these arguments, contact included, as its JSON text; null if it failed.
// Fast: it reads files, the log and a few commands, and never talks to the iPhone.
function diag_report(args) {
	mkdir(DIAG, 0700);
	const range = args?.range == 'week' ? 'week' : 'day';
	writefile(DIAG + '/contact.json', sprintf('%J', {
		email: substr('' + (args?.email ?? ''), 0, 400),
		note: substr('' + (args?.note ?? ''), 0, 8000)
	}));
	const result = run(DIAG_TOOL + ' bundle ' + range + ' ' + DIAG + '/contact.json');
	unlink(DIAG + '/contact.json');
	try { json(result.output); } catch (e) { return null; }
	return result.code == 0 ? result.output : null;
}

const methods = {
	status: {
		call: function() {
			const uci = cursor();
			const status = read_status();
			let devices = 0;
			uci.foreach('cellglide', 'device', () => { devices++; });
			return {
				running: service_running(),
				enabled: uci.get('cellglide', 'main', 'enabled') != '0',
				all: uci.get('cellglide', 'main', 'all') == '1',
				devices: devices,
				fallback: uci.get('cellglide', 'main', 'fallback') ?? 'broadband',
				version: trim(readfile('/usr/lib/cellglide/version') ?? ''),
				state: status.state ?? 'down',
				since: +(status.since ?? 0),
				device: status.device ?? '',
				name: status.name ?? '',
				udp: status.udp ?? 'unknown',
				dns: status.dns ?? 'router',
				dns4: uci.get('cellglide', 'main', 'dns') ?? '1.1.1.1',
				exit: status.exit ?? '',
				reason: status.reason ?? 'none',
				error: status.error ?? '',
				now: time()
			};
		}
	},

	// Whether the attached iPhone trusts this router, as the daemon last found. Running
	// idevicepair here would hold up rpcd, and every LuCI request with it, for as long as
	// the phone takes to answer, leaving other pages on "Loading view…".
	paired: {
		call: function() {
			const status = read_status();
			if (!status.device)
				return { device: false, paired: false };
			// The daemon validates only when the phone doesn't answer; when it does, the
			// phone's name (which an unpaired phone won't tell) says whether it's paired.
			let paired;
			switch (status.reason) {
			case 'not-paired': paired = false; break;
			case 'not-sharing': paired = true; break;
			default: paired = !!status.name;
			}
			return { device: true, paired: paired };
		}
	},

	// Shows "Trust this computer?" on the iPhone; the user taps Trust there.
	pair: {
		call: function() {
			const result = run('idevicepair pair');
			return { ok: result.code == 0, output: result.output };
		}
	},

	// The diagnostics report, for the page to show or save; nothing is sent.
	diag: {
		args: { range: 'day', email: '', note: '' },
		call: function(request) {
			const report = diag_report(request.args);
			return report ? { report: report } : { error: 'failed' };
		}
	},

	// Sends the report in the background: the upload can take up to 30 seconds, and rpcd
	// serves every LuCI request in one loop. The page asks diag_result until it's done.
	diag_send: {
		args: { range: 'day', email: '', note: '' },
		call: function(request) {
			const report = diag_report(request.args);
			if (!report)
				return { error: 'failed' };
			writefile(DIAG + '/report.json', report);
			writefile(DIAG + '/result.json', '{"state":"sending"}');
			system('(' + DIAG_TOOL + ' send ' + DIAG + '/report.json >' + DIAG + '/result.tmp; mv ' +
				DIAG + '/result.tmp ' + DIAG + '/result.json; rm -f ' + DIAG + '/report.json)' +
				' </dev/null >/dev/null 2>&1 &');
			return { ok: true };
		}
	},

	diag_result: {
		call: function() {
			let result = null;
			try { result = json(readfile(DIAG + '/result.json') ?? 'null'); } catch (e) { result = null; }
			if (!result)
				return { state: 'none' };
			if (result.state == 'sending')
				return { state: 'sending' };
			return result.code ? { state: 'sent', code: result.code }
				: { state: 'failed', error: result.error ?? 'bad-reply', status: result.status ?? 0 };
		}
	},

	start: {
		call: function() {
			run('/etc/init.d/cellglide enable');
			return { ok: run('/etc/init.d/cellglide start').code == 0 };
		}
	}
};

return { 'luci.cellglide': methods };
