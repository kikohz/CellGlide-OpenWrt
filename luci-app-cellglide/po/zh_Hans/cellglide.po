msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Name (optional)"
msgstr "名字（选填）"

msgid "Not a MAC address: %s"
msgstr "不是 MAC 地址：%s"

msgid "Add"
msgstr "添加"

msgid "CellGlide"
msgstr "CellGlide"

msgid "Every device"
msgstr "全部设备"

msgid "Send every device on the LAN through the iPhone"
msgstr "局域网里所有设备都走手机"

msgid "When on, the switches below don't matter. System updates, cloud sync and TV streaming then all use the iPhone's data."
msgstr "打开后，下面每台设备的开关不再生效。全家的系统更新、云同步、电视视频都会用手机流量。"

msgid "Devices"
msgstr "设备"

msgid "Recognized by MAC address, so a new IP address doesn't matter."
msgstr "按 MAC 地址识别，换了 IP 也不影响。"

msgid "Add a device by hand"
msgstr "手动添加设备"

msgid "For devices that aren't in the DHCP leases, such as a NAS or printer with a fixed IP address."
msgstr "给不在 DHCP 租约里的设备用，比如设了固定 IP 的 NAS 或打印机。"

msgid "Name"
msgstr "名称"

msgid "IP address"
msgstr "IP 地址"

msgid "MAC address"
msgstr "MAC 地址"

msgid "Through iPhone"
msgstr "走手机"

msgid "No devices yet. They appear here once they get an address from this router."
msgstr "还没有设备。设备从这台路由器拿到地址后会出现在这里。"

msgid "Note"
msgstr "备注"

msgid "Added by hand"
msgstr "手动添加"

msgid "Use the iPhone plugged into this router as the internet connection for chosen devices."
msgstr "把用数据线连着的 iPhone 当作被选设备的上网线路。"

msgid "Basic settings"
msgstr "基本设置"

msgid "General"
msgstr "常规"

msgid "Advanced"
msgstr "高级"

msgid "Enable"
msgstr "启用"

msgid "When off, every device uses the broadband line. The device list and settings are kept."
msgstr "关闭后所有设备照常走宽带，设备列表和设置会保留。"

msgid "When the iPhone is unavailable"
msgstr "手机不可用时"

msgid "Back to broadband: the chosen devices use the broadband line until the iPhone is back. Block: they have no internet, so nothing they send leaves over broadband."
msgstr "回到宽带：被选设备暂时改走宽带，手机恢复后自动切回。断网：被选设备直接断网，确保它们的流量不会从宽带出去。"

msgid "Back to broadband"
msgstr "回到宽带"

msgid "Block (no internet)"
msgstr "断网（block）"

msgid "DNS"
msgstr "DNS"

msgid "The chosen devices follow the DNS settings in CellGlide on the iPhone (encrypted DNS included), as a Mac does."
msgstr "被选设备的 DNS 跟随 iPhone 上 CellGlide 的设置（包括加密 DNS），和 Mac 一样。"

msgid "Name shown on the iPhone"
msgstr "在 iPhone 上显示的名字"

msgid "Empty uses this router's hostname."
msgstr "留空则用路由器的主机名。"

msgid "Fallback DNS (IPv4)"
msgstr "备用 DNS（IPv4）"

msgid "Used through the iPhone when CellGlide DNS is turned off on the iPhone. Needs CellGlide 2.3 or later."
msgstr "iPhone 上的 CellGlide 关闭 DNS 时，经手机发到这里。需要 CellGlide 2.3 或更新版本。"

msgid "Fallback DNS (IPv6)"
msgstr "备用 DNS（IPv6）"

msgid "Local DNS port"
msgstr "本机 DNS 端口"

msgid "Where this router takes the chosen devices' DNS before handing it to the iPhone."
msgstr "路由器在这个端口接收被选设备的 DNS，再交给 iPhone。"

msgid "iPhone proxy port"
msgstr "iPhone 代理端口"

msgid "Local proxy port"
msgstr "本机代理端口"

msgid "The port on this router that leads to the iPhone's proxy."
msgstr "路由器上转发到 iPhone 代理的端口。"

msgid "Pairing"
msgstr "配对"

msgid "The iPhone has to trust this router once. Plug it in, unlock it, then pair."
msgstr "iPhone 需要信任这台路由器一次。插上数据线、解锁手机，然后点配对。"

msgid "iPhone"
msgstr "iPhone"

msgid "No iPhone connected"
msgstr "没有连接 iPhone"

msgid "Not paired"
msgstr "未配对"

msgid "Paired · %s"
msgstr "已配对 · %s"

msgid "Paired"
msgstr "已配对"

msgid "Pair"
msgstr "配对"

msgid "Tap Trust on the iPhone and enter its passcode."
msgstr "请在 iPhone 上点“信任”，并输入锁屏密码。"

msgid "Paired."
msgstr "配对成功。"

msgid "Pairing didn't finish: %s"
msgstr "配对没有完成：%s"

msgid "no reply"
msgstr "没有回应"

msgid "About"
msgstr "关于"

msgid "Known limitations"
msgstr "已知限制"

msgid "CellGlide on the iPhone has to stay on screen while sharing."
msgstr "共享时 iPhone 上的 CellGlide 需要保持在前台。"

msgid "Chosen devices can't reach LAN devices by .lan names; use IP addresses. .local names still work."
msgstr "被选设备不能用 .lan 名字访问局域网设备，请改用 IP；.local 名字不受影响。"

msgid "Devices going through the iPhone can't be reached from the internet (no port forwarding)."
msgstr "外网无法连进走手机的设备（端口转发、远程访问不可用）。"

msgid "The router's own traffic (updates, DDNS) keeps using broadband."
msgstr "路由器自己的流量（系统更新、DDNS 等）仍走宽带。"

msgid "One iPhone at a time."
msgstr "一次只支持一台 iPhone。"

msgid "Version"
msgstr "版本"

msgid "Documentation"
msgstr "文档"

msgid "Every device on the LAN"
msgstr "局域网所有设备"

msgid "Meanwhile the chosen devices have no internet (block mode)."
msgstr "在此期间，被选设备断网（block 模式）。"

msgid "Meanwhile the chosen devices use the broadband line."
msgstr "在此期间，被选设备走宽带。"

msgid "CellGlide is not running"
msgstr "CellGlide 没有运行"

msgid "CellGlide is turned off"
msgstr "CellGlide 已停用"

msgid "Start the service to use the iPhone."
msgstr "启动服务后才能使用手机网络。"

msgid "Turn it on in Settings to use the iPhone."
msgstr "在设置里启用后才能使用手机网络。"

msgid "Start"
msgstr "启动"

msgid "Settings"
msgstr "设置"

msgid "Using the iPhone's connection"
msgstr "正在使用手机网络"

msgid "Every device on the LAN goes online through the iPhone, since %s."
msgstr "局域网所有设备经 iPhone 上网，从 %s 开始。"

msgid "%s go online through the iPhone, since %s."
msgstr "%s经 iPhone 上网，从 %s 开始。"

msgid "Plug the iPhone into the router's USB port, open CellGlide and tap Start sharing."
msgstr "把 iPhone 插到路由器的 USB 口，打开 CellGlide，点“开始共享”。"

msgid "The iPhone isn't paired with this router"
msgstr "iPhone 还没有和这台路由器配对"

msgid "Pair it in Settings, then tap Trust on the iPhone."
msgstr "请在设置里配对，然后在 iPhone 上点“信任”。"

msgid "CellGlide isn't sharing"
msgstr "CellGlide 没有在共享"

msgid "Open CellGlide on the iPhone and tap Start sharing. Keep it on screen while in use."
msgstr "在 iPhone 上打开 CellGlide，点“开始共享”，使用时保持在前台。"

msgid "The connection to the iPhone didn't start"
msgstr "和 iPhone 的连接没有建立"

msgid "It retries every few seconds. If this stays, check the system log for cellglide."
msgstr "每隔几秒会自动重试。一直这样的话，请在系统日志里查看 cellglide 的记录。"

msgid "Waiting for the iPhone"
msgstr "正在等待 iPhone"

msgid "Checking every 5 seconds."
msgstr "每 5 秒检查一次。"

msgid "Not connected"
msgstr "未连接"

msgid "In use since %s"
msgstr "在用，从 %s 开始"

msgid "Not in use"
msgstr "不在用"

msgid "Works"
msgstr "正常"

msgid "Needs CellGlide 2.3 or later on the iPhone"
msgstr "需要 iPhone 上的 CellGlide 2.3 或更新版本"

msgid "Websites work; calls, games and other UDP apps don't yet."
msgstr "网页照常可用；通话、游戏等用 UDP 的应用暂时不行。"

msgid "Unknown"
msgstr "未知"

msgid "Sharing"
msgstr "共享状态"

msgid "UDP"
msgstr "UDP"

msgid "Follows the DNS settings in CellGlide on the iPhone"
msgstr "跟随 iPhone 上 CellGlide 的 DNS 设置"

msgid "%s through the iPhone"
msgstr "%s（经手机）"

msgid "CellGlide DNS is off on the iPhone."
msgstr "iPhone 上的 CellGlide 关闭了 DNS。"

msgid "Answered by the router (over broadband)"
msgstr "由路由器解析（走宽带）"

msgid "Exit IP"
msgstr "出口 IP"

msgid "The address websites see from the chosen devices"
msgstr "网站看到的被选设备的地址"

msgid "Manage devices"
msgstr "管理设备"

msgid "Change"
msgstr "修改"

msgid "Refreshed every 5 seconds."
msgstr "每 5 秒刷新一次。"

msgid "Status"
msgstr "状态"

msgid "%d chosen device"
msgid_plural "%d chosen devices"
msgstr[0] "%d 台被选设备"
