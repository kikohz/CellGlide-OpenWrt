#!/usr/bin/ucode
// Talks to the SOCKS5 server CellGlide shares over USB, reached through iproxy.
//   probe greet PORT  exit 0 when the server answers the SOCKS5 greeting
//   probe udp PORT    exit 0 when it accepts hev's UDP-in-TCP command (0x05),
//                     3 when it refuses it (CellGlide before 2.3), 1 otherwise
//   probe dns PORT    PORT leads to the phone's port 8088: exit 0 when the app's own DNS
//                     is on (the router can hand DNS to it), 4 when it's off, 1 otherwise
'use strict';

import * as socket from 'socket';

const mode = ARGV[0], port = +ARGV[1];

function read_exact(conn, count) {
	let data = '';
	while (length(data) < count) {
		const ready = socket.poll(2000, conn);
		if (!ready?.[0]?.[1])
			return null;
		const chunk = conn.recv(count - length(data));
		if (!length(chunk))
			return null;
		data += chunk;
	}
	return data;
}

if ((mode != 'greet' && mode != 'udp' && mode != 'dns') || !port) {
	warn('usage: probe greet|udp|dns PORT\n');
	exit(2);
}

if (mode == 'dns') {
	const conn = socket.connect('127.0.0.1', port, null, 2000);
	if (!conn)
		exit(1);
	conn.send('GET /cellproxy/hello HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n');
	let reply = '';
	while (length(reply) < 16384) {
		const ready = socket.poll(3000, conn);
		if (!ready?.[0]?.[1])
			break;
		const chunk = conn.recv(4096);
		if (!length(chunk))
			break;
		reply += chunk;
	}
	conn.close();
	let hello = null;
	try { hello = json(split(reply, '\r\n\r\n', 2)[1] ?? ''); } catch (e) { exit(1); }
	if (type(hello?.dns?.enabled) != 'bool')
		exit(1);
	exit(hello.dns.enabled ? 0 : 4);
}

// iproxy accepts the TCP connection even without an iPhone, then closes it,
// so a successful connect alone proves nothing.
const conn = socket.connect('127.0.0.1', port, null, 2000);
if (!conn)
	exit(1);

conn.send(chr(5, 1, 0));
if (read_exact(conn, 2) != chr(5, 0)) {
	conn.close();
	exit(1);
}

if (mode == 'udp') {
	conn.send(chr(5, 5, 0, 1, 0, 0, 0, 0, 0, 0));
	const reply = read_exact(conn, 2);
	conn.close();
	if (reply == null)
		exit(1);
	exit(ord(reply, 1) == 0 ? 0 : 3);
}

conn.close();
exit(0);
