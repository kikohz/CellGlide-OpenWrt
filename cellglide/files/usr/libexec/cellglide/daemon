#!/bin/sh
# Watches the iPhone and moves the chosen devices between it and the broadband line.
# Run by procd (/etc/init.d/cellglide); SIGTERM undoes every change it made.

# shellcheck source=/dev/null
. /lib/functions.sh
# shellcheck source=/dev/null
. /usr/lib/cellglide/common.sh
# shellcheck source=/dev/null
. /usr/lib/cellglide/net.sh

RUN=/var/run/cellglide
PROBE=/usr/libexec/cellglide/probe
HEV_PID=""
STATE=down
FAILS=0
UDP=unknown
DEVICE=""
NAME=""
NAMED=""
EXIT=""
# Who answers the chosen devices' DNS: phone (the app's resolver, through the forwarder),
# public (the dns/dns6 servers through the iPhone) or router (dnsmasq, over broadband).
DNS=router
ERROR=""
# What the web interface translates: none, no-iphone, not-paired, not-sharing or tunnel.
REASON=none
MACS=""

add_device() {
	local mac
	config_get mac "$1" mac
	mac=$(cg_normalize_mac "$mac") && MACS="$MACS $mac"
}

config_load cellglide
config_get LOCAL_PORT main local_port 19876
config_get FALLBACK main fallback broadband
config_get DNS4 main dns 1.1.1.1
config_get DNS6 main dns6 2606:4700:4700::1111
config_get DNS_PORT main dns_port 5354
config_get WATCH_PORT main local_watch_port 19088
config_foreach add_device device
# "cellglide add all": every LAN device, whatever is listed.
config_get_bool ALL main all 0
[ "$ALL" = 1 ] && MACS="all"

log() {
	logger -t cellglide "$*"
}

write_status() {
	printf "state='%s'\nsince='%s'\ndevice='%s'\nname='%s'\nudp='%s'\ndns='%s'\nexit='%s'\nreason='%s'\nerror='%s'\n" \
		"$STATE" "$SINCE" "$DEVICE" "$NAME" "$UDP" "$DNS" "$EXIT" "$REASON" "$ERROR" >"$RUN/status.tmp" &&
		mv "$RUN/status.tmp" "$RUN/status"
}

# The iPhone's own name (Settings › General › About), looked up once per phone. An
# unpaired phone won't tell, so it is asked again each round until it does.
phone_name() {
	[ "$DEVICE" = "$NAMED" ] && [ -n "$NAME" ] && return
	NAMED=$DEVICE
	NAME=""
	[ -n "$DEVICE" ] && NAME=$(cg_status_value "$(ideviceinfo -u "$DEVICE" -k DeviceName 2>/dev/null | head -n 1)")
}

# The exit address the chosen devices get, when curl is installed (it is optional).
exit_address() {
	EXIT=""
	command -v curl >/dev/null || return
	EXIT=$(cg_status_value "$(curl -s -m 5 --interface "$CG_TUN" https://speed.cloudflare.com/cdn-cgi/trace | sed -n 's/^ip=//p')")
}

lan_routes() {
	ip -"$1" route show table main dev "$CG_LAN" | cg_lan_routes
}

load_nft() {
	# shellcheck disable=SC2086 # one argument per MAC
	cg_nft_ruleset "$DNS4" "$DNS6" "$1" "$DNS_PORT" $MACS | cg_nft_apply 2>"$RUN/nft.err" ||
		log "nft rules failed to load: $(head -n 3 "$RUN/nft.err" | tr '\n' ' ')"
}

hev_stop() {
	if [ -n "$HEV_PID" ]; then
		kill "$HEV_PID" 2>/dev/null
		wait "$HEV_PID" 2>/dev/null
		HEV_PID=""
	fi
}

hev_alive() {
	[ -n "$HEV_PID" ] && kill -0 "$HEV_PID" 2>/dev/null
}

# A previous instance killed with SIGKILL leaves its hev (and cgtun) behind.
kill_stale_hev() {
	local pid killed="" tries=0
	for pid in $(pgrep -f "hev-socks5-tunnel $RUN/hev.yml"); do
		kill "$pid" 2>/dev/null && killed=1
	done
	# Give the kernel time to drop cgtun, or the next hev cannot create it.
	if [ -n "$killed" ]; then
		while [ -d "/sys/class/net/$CG_TUN" ] && [ "$tries" -lt 6 ]; do
			sleep 0.5
			tries=$((tries + 1))
		done
	fi
}

go_up() {
	local tries=0
	hev_stop
	kill_stale_hev
	cg_hev_config "$LOCAL_PORT" >"$RUN/hev.yml"
	hev-socks5-tunnel "$RUN/hev.yml" &
	HEV_PID=$!
	while [ ! -d "/sys/class/net/$CG_TUN" ] && [ "$tries" -lt 10 ]; do
		sleep 1
		tries=$((tries + 1))
	done
	if [ ! -d "/sys/class/net/$CG_TUN" ]; then
		ERROR="the tunnel did not start"
		REASON=tunnel
		hev_stop
		return 1
	fi
	cg_setup "$FALLBACK" "$(lan_routes 4)" "$(lan_routes 6)" || log "cg_setup reported failures"
	if ! cg_tunnel_up; then
		ERROR="could not route through the tunnel"
		REASON=tunnel
		log "cg_tunnel_up failed"
		hev_stop
		return 1
	fi
	"$PROBE" udp "$LOCAL_PORT"
	case $? in
	0) UDP=yes ;;
	3) UDP=no ;;
	*) UDP=unknown ;;
	esac
	choose_dns
	exit_address
	log "using the iPhone for:${MACS:- no devices yet}"
}

# The app's own resolver when it's on (it reaches the phone over TCP, so it works without
# UDP-in-TCP too); else the public servers through the iPhone when UDP works; else dnsmasq.
choose_dns() {
	local dns
	if "$PROBE" dns "$WATCH_PORT"; then
		dns=phone
	elif [ "$UDP" = yes ]; then
		dns=public
	else
		dns=router
	fi
	[ "$dns" = "$DNS" ] && [ "$1" = keep ] && return
	DNS=$dns
	case "$DNS" in
	phone) load_nft "local:$DNS_PORT" ;;
	public) load_nft 1 ;;
	*) load_nft 0 ;;
	esac
}

go_down() {
	DNS=router
	load_nft 0
	cg_tunnel_down
	hev_stop
	UDP=unknown
	EXIT=""
	log "iPhone unavailable ($ERROR), devices use: $FALLBACK"
}

cleanup() {
	hev_stop
	cg_teardown
	rm -f "$RUN/status" "$RUN/status.tmp" "$RUN/hev.yml" "$RUN/nft.err"
	exit 0
}

trap cleanup INT TERM

mkdir -p "$RUN"
kill_stale_hev
cg_setup "$FALLBACK" "$(lan_routes 4)" "$(lan_routes 6)" || log "initial cg_setup reported failures"
load_nft 0
SINCE=$(date +%s)
write_status

while :; do
	DEVICE=$(idevice_id -l 2>/dev/null | head -n 1)
	# A UDID comes from the USB serial string; anything that isn't one counts as no phone,
	# so it never reaches the status file (sourced by the command line) or a command.
	case "$DEVICE" in
	*[!0-9A-Fa-f-]*) DEVICE="" ;;
	esac
	phone_name
	if [ -z "$DEVICE" ]; then
		probe=1
		ERROR="no iPhone connected"
		REASON=no-iphone
	elif "$PROBE" greet "$LOCAL_PORT"; then
		probe=0
		ERROR=""
		REASON=none
	elif ! idevicepair -u "$DEVICE" validate >/dev/null 2>&1; then
		probe=1
		ERROR="the iPhone is not paired (run cellglide pair)"
		REASON=not-paired
	else
		probe=1
		ERROR="CellGlide is not sharing"
		REASON=not-sharing
	fi
	next=$(cg_next_state "$STATE" "$FAILS" "$probe")
	FAILS=${next#* }
	next=${next% *}
	if [ "$next" = up ] && { [ "$STATE" = down ] || ! hev_alive; }; then
		# Also restarts hev if it exited while the iPhone was in use.
		if go_up; then
			[ "$STATE" = down ] && SINCE=$(date +%s)
			STATE=up
		else
			if [ "$STATE" = up ]; then
				go_down
				SINCE=$(date +%s)
			fi
			STATE=down
		fi
	elif [ "$next" = down ] && [ "$STATE" = up ]; then
		go_down
		STATE=down
		SINCE=$(date +%s)
	elif [ "$STATE" = up ]; then
		# The app's DNS can be switched on or off while sharing; one local request a round.
		choose_dns keep
	fi
	write_status
	# Sleep in the background so SIGTERM is handled right away.
	sleep 5 &
	wait $!
done
