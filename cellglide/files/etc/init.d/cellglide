#!/bin/sh /etc/rc.common
# Runs iproxy (the iPhone's SOCKS port on this router) and the cellglide daemon.

USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled local_port socks_port local_watch_port watch_port dns_port

	config_load cellglide
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get local_port main local_port 19876
	config_get socks_port main socks_port 9876
	config_get local_watch_port main local_watch_port 19088
	config_get watch_port main watch_port 8088

	# The phone's SOCKS port, and its port 8088 where the router reports itself.
	procd_open_instance iproxy
	procd_set_param command /usr/bin/iproxy -l "$local_port:$socks_port" "$local_watch_port:$watch_port"
	procd_set_param respawn
	procd_set_param file /etc/config/cellglide
	procd_close_instance

	procd_open_instance report
	procd_set_param command /usr/libexec/cellglide/report "$local_watch_port"
	procd_set_param respawn
	procd_set_param file /etc/config/cellglide /etc/config/system
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Answers the chosen devices' DNS with the app's resolver on the iPhone.
	config_get dns_port main dns_port 5354
	procd_open_instance dns
	procd_set_param command /usr/libexec/cellglide/dns "$dns_port" "$local_watch_port"
	procd_set_param respawn
	procd_set_param file /etc/config/cellglide
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance daemon
	procd_set_param command /usr/libexec/cellglide/daemon
	procd_set_param respawn
	procd_set_param file /etc/config/cellglide
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# procd SIGKILLs the daemon if it outlives term_timeout, which skips its own cleanup.
service_stopped() {
	local pid
	# shellcheck source=/dev/null
	. /usr/lib/cellglide/common.sh
	# shellcheck source=/dev/null
	. /usr/lib/cellglide/net.sh
	for pid in $(pgrep -f "hev-socks5-tunnel /var/run/cellglide/hev.yml"); do
		kill "$pid" 2>/dev/null
	done
	cg_teardown
}

service_triggers() {
	procd_add_reload_trigger cellglide
}
